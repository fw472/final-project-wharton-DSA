## Regressions
##1, Poverty Rate

```{r}
ggplot(county_data,
       aes(x = poverty_rate_2007,
           y = recovery_ratio_2008)) +
  geom_point(alpha = 0.4) +
  geom_smooth(method = "lm",
              se = TRUE,
              color = "red") +
  labs(
    x = "Poverty Rate (2007)",
    y = "Recovery Ratio (2008)",
    title = "Recovery Ratio vs Poverty Rate"
  ) +
  theme_minimal()

poverty_rate <- lm(
  recovery_ratio_2008 ~ poverty_rate_2007,
  data = county_data
)

summary(poverty_rate)
```

